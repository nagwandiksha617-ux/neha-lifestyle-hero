# NEHA Lifestyle — static shared hosting (Apache/cPanel)
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Serve real files and directories directly (hashed assets, prerendered dirs).
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Prerendered routes: /category/bags -> /category/bags/index.html without a redirect hop.
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}/index.html -f
  RewriteRule ^(.*)$ %{REQUEST_URI}/index.html [L]

  # Anything else falls through to the custom 404 page below.
</IfModule>

# Custom 404 page for URLs without a prerendered page.
ErrorDocument 404 /404.html

# Long-lived caching for hashed build assets.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Compression.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>
